{
  "name": "minifetch-api",
  "version": "1.10.1",
  "description": "Minifetch.com API Client. Search, scrape, extract and SEO audit web pages. Pay per fetch, no subscription.",
  "type": "module",
  "packageManager": "pnpm@10.10.0",
  "main": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "html",
    "web page",
    "scraper",
    "parser",
    "proxy",
    "rotating proxy",
    "metadata",
    "metadata extraction",
    "content extraction",
    "link extraction",
    "search",
    "keyword search",
    "hosted",
    "meta tags",
    "open graph",
    "og tags",
    "previews",
    "social cards",
    "twitter cards",
    "pay-per-fetch",
    "pay-per-url",
    "indexing",
    "extract",
    "json-ld",
    "JSON LD",
    "link analysis",
    "SEO",
    "SEO page audit",
    "SEO research",
    "SEO toolkit",
    "SEO skill",
    "technical SEO",
    "GEO",
    "Generative Engine Optimization",
    "AEO",
    "Answer Engine Optimization",
    "AI",
    "AI Agents",
    "AI readability",
    "automation",
    "LLM",
    "x402",
    "micropayments",
    "usdc"
  ],
  "bugs": {
    "url": "https://github.com/Niche-Networks/minifetch-api/issues"
  },
  "homepage": "https://minifetch.com",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/Niche-Networks/minifetch-api.git"
  },
  "scripts": {
    "dist:clean": "rm -rf dist",
    "build": "pnpm run dist:clean && pnpm run build:esm",
    "build:esm": "tsc -p tsconfig.json",
    "format": "prettier -c .prettierrc --write \"**/*.{ts,js,cjs,json,md}\"",
    "format:check": "prettier -c .prettierrc --check \"**/*.{ts,js,cjs,json,md}\"",
    "lint": "eslint . --ext .ts --fix",
    "lint:check": "eslint . --ext .ts",
    "test": "SKIP_DEBUG_TESTS=true vitest",
    "test:run": "SKIP_DEBUG_TESTS=true vitest run",
    "test:file": "vitest run",
    "test:debug": "vitest run test/debug.test.ts",
    "test:coverage": "vitest run --coverage",
    "example:ts": "cd example-typescript && pnpm install && pnpm start",
    "example:js": "cd example-javascript && pnpm install && pnpm start",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@solana/kit": "^8.6.0",
    "@x402/evm": "^2.30.0",
    "@x402/fetch": "^2.30.0",
    "@x402/svm": "^2.30.0",
    "bs58": "^6.0.0",
    "viem": "^2.57.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.6.6",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitest/coverage-v8": "^5.1.0",
    "dotenv": "^16.4.7",
    "eslint": "^9.39.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^65.4.5",
    "eslint-plugin-prettier": "^5.5.7",
    "prettier": "3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"],
    "ignoredBuiltDependencies": ["bufferutil", "utf-8-validate"]
  },
  "license": "MIT"
}
